#!/usr/bin/osascript
-- ⌘⇧S: handoff from the front Terminal tab (headless shell + native Skeptic sheets).
-- Silent no-op when Terminal is not front — avoids surprise dialogs in Cursor, browser, etc.

on silentNote(msg)
	try
		display notification msg with title "Skeptic · Session Handoff"
	on error
		-- notification optional
	end try
end silentNote

on run
	set shortTTY to ""
	set tabTitle to ""
	try
		tell application "System Events"
			set frontName to name of first application process whose frontmost is true
		end tell
		if frontName is not "Terminal" then
			return
		end if
		tell application "Terminal"
			if (count of windows) is 0 then
				my silentNote("Open Terminal on the stuck AI tab, then press ⌘⇧S.")
				return
			end if
			set selTab to selected tab of front window
			set rawTTY to tty of selTab
			if rawTTY is missing value then
				my silentNote("Could not read this tab — click the stuck tab and try ⌘⇧S again.")
				return
			end if
			set shortTTY to text 6 thru -1 of rawTTY
			try
				set tabTitle to custom title of selTab
			on error
				set tabTitle to ""
			end try
		end tell
	on error errMsg number errNum
		if errNum is -128 then return
		my silentNote(errMsg)
		return
	end try
	if shortTTY is "" then return
	set home to POSIX path of (path to home folder)
	set widgetDir to home & ".skeptic-widget/"
	do shell script "/bin/mkdir -p " & quoted form of widgetDir
	set debounce to "now=$(date +%s); last=$(cat " & quoted form of (widgetDir & "last-switch") & " 2>/dev/null || echo 0); test $((now - last)) -ge 2 || exit 200; printf %s \"$now\" > " & quoted form of (widgetDir & "last-switch")
	try
		do shell script debounce
	on error errMsg number errNum
		if errNum is 200 then return
		my silentNote(errMsg)
		return
	end try
	do shell script "/usr/bin/printf %s " & quoted form of shortTTY & " > " & quoted form of (widgetDir & "hint-tty")
	do shell script "/usr/bin/printf %s " & quoted form of tabTitle & " > " & quoted form of (widgetDir & "hint-title")
	set skeptic to quoted form of (home & ".local/bin/skeptic")
	set cmd to "export SKEPTIC_HOTKEY=1; export SKEPTIC_HINT_TTY=" & quoted form of shortTTY & "; export SKEPTIC_HINT_TITLE=" & quoted form of tabTitle & "; " & skeptic
	do shell script cmd
end run